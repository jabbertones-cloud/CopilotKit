{
  "name": "@copilotkit/showcase-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/orchestrator.ts",
    "start": "node dist/orchestrator.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.710.0",
    "@hono/node-server": "^1.14.0",
    "axe-core": "4.11.1",
    "chokidar": "^4.0.3",
    "commander": "^14.0.3",
    "croner": "^9.0.0",
    "hono": "^4.6.0",
    "js-yaml": "^4.1.0",
    "mustache": "^4.2.0",
    "ulid": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/mustache": "^4.2.5",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "nx": {
    "targets": {
      "test:signal-boundary:case": {
        "dependsOn": [],
        "cache": false
      },
      "test:signal-boundary": {
        "dependsOn": [],
        "cache": false
      },
      "test:ci": {
        "dependsOn": [
          "^build"
        ],
        "cache": false
      },
      "test:d4-boundary": {
        "dependsOn": [],
        "cache": false
      },
      "test:quarantine-ratchet": {
        "dependsOn": [
          "^build"
        ],
        "cache": false
      }
    }
